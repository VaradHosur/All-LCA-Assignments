#include <stdio.h>

int main() { int year; int month, day, startDay, i;

int daysInMonth[] = {
    31, 28, 31, 30, 31, 30,
    31, 31, 30, 31, 30, 31
};

char *Months[] = {
    "January", "February", "March", "April",
    "May", "June", "July", "August",
    "September", "October", "November", "December"
};

printf("Enter year: ");
scanf("%d", &year);

// Calculate the starting day of the year
startDay = (year * 365 + (year - 1) / 4
            - (year - 1) / 100
            + (year - 1) / 400) % 7;

printf("\n*********** Calendar for %d ***********\n", year);

for (month = 0; month < 12; month++)
{
    printf("\n\n------------- %s %d -------------\n",
           Months[month], year);

    printf(" Sun Mon Tue Wed Thu Fri Sat\n");

    // Print spaces before the first day
    for (i = 0; i < startDay; i++)
    {
        printf("    ");
    }

    // Print all days of the month
    for (day = 1; day <= daysInMonth[month]; day++)
    {
        printf("%4d", day);

        if ((startDay + day) % 7 == 0)
        {
            printf("\n");
        }
    }

    printf("\n");

    // Calculate the starting day of the next month
    startDay = (startDay + daysInMonth[month]) % 7;
}

return 0;
}
